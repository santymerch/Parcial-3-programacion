        <mxCell id="c64" value="Si: fecha_ini &amp;gt; fecha_fin entonces LANZAR ERROR" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;fontSize=11;" parent="c63" vertex="1"><mxGeometry y="44" width="560" height="24" as="geometry" /></mxCell>
        <mxCell id="c65" value="titulos = {isbn: titulo} de repo_libro_find_all()" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;fontSize=11;" parent="c63" vertex="1"><mxGeometry y="68" width="560" height="24" as="geometry" /></mxCell>
