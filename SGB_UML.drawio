        <mxCell id="c30" value="libro.disponibles = MIN(libro.disponibles + 1, libro.total_ejemplares)" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;fontSize=11;" parent="c24" vertex="1"><mxGeometry y="164" width="560" height="24" as="geometry" /></mxCell>
