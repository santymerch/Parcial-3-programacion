        <mxCell id="c19" value="&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;r = leer_campo(campos[i], valores, i + 1, total, valores[clave])" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;fontSize=11;" parent="c15" vertex="1"><mxGeometry y="116" width="560" height="24" as="geometry" /></mxCell>
        <mxCell id="c20" value="&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Si: r = &amp;quot;*&amp;quot; entonces MOSTRAR &amp;quot;Operación cancelada&amp;quot; y ENTREGAR nulo" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;fontSize=11;" parent="c15" vertex="1"><mxGeometry y="140" width="560" height="24" as="geometry" /></mxCell>
        <mxCell id="c21" value="&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Si: r = &amp;quot;&amp;lt;&amp;quot; entonces i = i - 1 (si i = 0 avisa &amp;quot;ya está en el primer campo&amp;quot;)" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;fontSize=11;" parent="c15" vertex="1"><mxGeometry y="164" width="560" height="24" as="geometry" /></mxCell>
        <mxCell id="c22" value="&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Si No: valores[campos[i].clave] = r ; i = i + 1" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;fontSize=11;" parent="c15" vertex="1"><mxGeometry y="188" width="560" height="24" as="geometry" /></mxCell>
