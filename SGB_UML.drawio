        <mxCell id="c27" value="Si: fecha &amp;lt; p.fecha_prestamo o fecha &amp;gt; hoy entonces LANZAR ERROR" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;fontSize=11;" parent="c24" vertex="1"><mxGeometry y="92" width="560" height="24" as="geometry" /></mxCell>
        <mxCell id="c28" value="p.fecha_devolucion = fecha ; p.estado = DEVUELTO" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;fontSize=11;" parent="c24" vertex="1"><mxGeometry y="116" width="560" height="24" as="geometry" /></mxCell>
