        <mxCell id="c70" value="PARA CADA tipo EN TIPO_USUARIO_ENUM:" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;fontSize=11;" parent="c68" vertex="1"><mxGeometry y="68" width="560" height="24" as="geometry" /></mxCell>
        <mxCell id="c71" value="&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;prestamos = préstamos de usuarios de ese tipo" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;fontSize=11;" parent="c68" vertex="1"><mxGeometry y="92" width="560" height="24" as="geometry" /></mxCell>
        <mxCell id="c72" value="&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;morosos = préstamos VENCIDOS o devueltos después de la fecha límite" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;fontSize=11;" parent="c68" vertex="1"><mxGeometry y="116" width="560" height="24" as="geometry" /></mxCell>
        <mxCell id="c73" value="&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;tasa = morosos / total × 100   (0 si no hay préstamos)" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;fontSize=11;" parent="c68" vertex="1"><mxGeometry y="140" width="560" height="24" as="geometry" /></mxCell>
