        <mxCell id="c12" value="&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Si: op NO está en acciones entonces MOSTRAR &amp;quot;Opción no válida&amp;quot; y CONTINUAR" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;fontSize=11;" parent="c8" vertex="1"><mxGeometry y="116" width="560" height="24" as="geometry" /></mxCell>
